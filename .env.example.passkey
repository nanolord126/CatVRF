# Passkey Authentication Configuration

# Relying Party Configuration
PASSKEY_RP_ID=catvrf.ru
PASSKEY_RP_NAME="CatVRF Healthcare Marketplace"
PASSKEY_RP_ORIGIN=https://catvrf.ru

# Challenge Configuration
PASSKEY_CHALLENGE_TTL=300

# Authentication Configuration
PASSKEY_USER_VERIFICATION=preferred
PASSKEY_TIMEOUT=60000

# Registration Configuration
PASSKEY_AUTHENTICATOR_ATTACHMENT=platform
PASSKEY_REGISTRATION_USER_VERIFICATION=required
PASSKEY_RESIDENT_KEY=preferred
PASSKEY_ATTESTATION=none

# Security Configuration
PASSKEY_REQUIRE_VERIFICATION_SENSITIVE=true
PASSKEY_MAX_CREDENTIALS=10
PASSKEY_ALLOW_DELETION=true
PASSKEY_REQUIRE_AT_LEAST_ONE=true

# Multi-Tenancy Configuration
PASSKEY_MULTI_TENANCY_ENABLED=true
PASSKEY_ISOLATE_CREDENTIALS=true

# Monitoring Configuration
PASSKEY_LOG_FAILURES=true
PASSKEY_LOG_SUCCESSES=true
PASSKEY_METRICS_ENABLED=true
