ADAPTIVE_WEIGHT_DEVICE=0.20
ADAPTIVE_WEIGHT_GEO_VELOCITY=0.15
ADAPTIVE_WEIGHT_TIME_PATTERN=0.10
ADAPTIVE_WEIGHT_AUTH_HISTORY=0.10
