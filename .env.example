ADAPTIVE_AUTH_ENABLED=true
ADAPTIVE_LOW_RISK_THRESHOLD=0.30
ADAPTIVE_MEDIUM_RISK_THRESHOLD=0.50
ADAPTIVE_HIGH_RISK_THRESHOLD=0.70
ADAPTIVE_CRITICAL_RISK_THRESHOLD=0.85
ADAPTIVE_STEP_UP_TTL=300
