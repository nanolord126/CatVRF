BEHAVIORAL_TYPING_SAMPLE_SIZE=100
BEHAVIORAL_MOUSE_ENABLED=true
BEHAVIORAL_MOUSE_SAMPLE_SIZE=50
BEHAVIORAL_TOUCH_ENABLED=true
BEHAVIORAL_TOUCH_SAMPLE_SIZE=30

