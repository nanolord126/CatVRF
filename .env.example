# ВНИМАНИЕ: Использование .env запрещено (Zero Trust 2026). Используйте Doppler.

# === WMS COMPLIANCE CONFIGURATION ===
# Cold Chain Monitoring (ФЗ-323)
COLD_CHAIN_MIN_TEMP=2.0
COLD_CHAIN_MAX_TEMP=25.0
COLD_CHAIN_HUMIDITY_MIN=30.0
COLD_CHAIN_HUMIDITY_MAX=75.0
COLD_CHAIN_ALERT_THRESHOLD=15

# ЕГИСЗ (ФЗ-323)
WAREHOUSE_EGISZ_ENABLED=false
WAREHOUSE_EGISZ_API_URL=https://egisz.rosminzdrav.gov.ru/api
WAREHOUSE_EGISZ_API_KEY=
WAREHOUSE_EGISZ_API_VERSION=v1
WAREHOUSE_EGISZ_TIMEOUT=30

# Cold Chain Monitoring (ФЗ-323)
WAREHOUSE_COLD_CHAIN_ENABLED=true

# Prescription Drug Control (ФЗ-323)
WAREHOUSE_PRESCRIPTION_DRUGS_ENABLED=true

# EGISZ Integration (ФЗ-323)
EGISZ_API_URL=https://api.egisz.rosminzdr.gov.ru
EGISZ_API_KEY=your_egisz_api_key
EGISZ_CERTIFICATE_PATH=/path/to/certificate.pem
EGISZ_TIMEOUT=30

# 1C Integration
ONEC_API_URL=https://1c.yourdomain.com/hs/api
ONEC_USERNAME=your_1c_username
ONEC_PASSWORD=your_1c_password
ONEC_TIMEOUT=120

# WMS Rate Limiting
WMS_RATE_LIMIT_DEFAULT=60
WMS_RATE_LIMIT_STOCK_MOVEMENT=100
WMS_RATE_LIMIT_BATCH_OPERATIONS=50
WMS_RATE_LIMIT_REPORTS=20
WMS_RATE_LIMIT_INTEGRATION=30

# WMS Cache
WMS_CACHE_DEFAULT_TTL=3600
WMS_CACHE_STOCK_TTL=300
WMS_CACHE_CONFIG_TTL=7200

# Barcode Configuration
BARCODE_DEFAULT_TYPE=CODE128
BARCODE_AUTO_GENERATE=true

# === AUDIT VERTICAL CONFIGURATION ===
# Audit Logging (152-FZ Compliance)
AUDIT_ENABLED=true
AUDIT_ASYNC=true
AUDIT_QUEUE=audit-logs
AUDIT_QUEUE_CONNECTION=redis
AUDIT_RETENTION_MONTHS=12
AUDIT_PRUNE_SCHEDULE="0 0 * * *"
AUDIT_DEVICE_FINGERPRINTING=true
AUDIT_CORRELATION_ID=true
AUDIT_LOG_USER_AGENT=true
AUDIT_LOG_URL=true
AUDIT_LOG_IP_ADDRESS=true
AUDIT_GDPR_ENABLED=true
AUDIT_LOG_EVENTS=false

# Compliance Thresholds
FZ61_EXPIRY_THRESHOLD=30

# === SECURITY FLAGS (обязательно выставить в prod) ===
# Отключить header-based tenant resolver (X-Tenant-ID) на проде!
TENANT_HEADER_RESOLVER=false

# === OCTANE PERFORMANCE OPTIMIZATION 2026 ===
# Server: roadrunner (recommended for production), swoole, frankenphp
OCTANE_SERVER=roadrunner
# Octane HTTP/HTTPS listener
OCTANE_HTTPS=false
# Garbage collection threshold (null = disabled, recommended for production)
OCTANE_GC=null
# Maximum execution time per request (seconds)
OCTANE_MAX_EXECUTION_TIME=30
# RoadRunner binary path
OCTANE_ROADRUNNER_BINARY=rr
# RoadRunner config file
OCTANE_ROADRUNNER_CONFIG=.rr.yaml

# Swoole Configuration (if using swoole server)
SWOOLE_HTTP_WORKER_COUNT=auto
SWOOLE_TASK_WORKER_COUNT=auto
SWOOLE_TASK_WORKER_MAX_REQUEST=1000
SWOOLE_HTTP_WORKER_MAX_REQUEST=5000
SWOOLE_MAX_REQUEST=5000
SWOOLE_DAEMONIZE=false
SWOOLE_SSL_CERT_FILE=
SWOOLE_SSL_KEY_FILE=

# FrankenPHP Configuration (if using frankenphp server)
FRANKENPHP_HOST=127.0.0.1
FRANKENPHP_PORT=8000
FRANKENPHP_WORKERS=auto
FRANKENPHP_MAX_REQUESTS=5000
FRANKENPHP_COMPRESS=true
FRANKENPHP_LOGGER=stdout

# Cache driver for Octane (redis recommended for production)
OCTANE_CACHE_DRIVER=redis

# === CENTRAL DOMAIN ===
CENTRAL_DOMAIN=catvrf.ru
CENTRAL_ADMIN_DOMAIN=admin.catvrf.ru

