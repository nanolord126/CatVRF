# === WEBSOCKET SCALING - 28 VERTICALS ===
# Laravel Reverb Horizontal Scaling Configuration

# Reverb Scaling - Enable Redis adapter for horizontal scaling
REVERB_SCALING_ENABLED=false
REVERB_REDIS_CONNECTION=default
REVERB_REDIS_PREFIX=reverb

# Reverb Connection Limits - Max concurrent connections per instance
REVERB_MAX_CONNECTIONS=10000

# Reverb Rate Limiting - Global abuse prevention
REVERB_RATE_LIMITING_ENABLED=true
REVERB_MAX_MESSAGES_PER_SECOND=1000
REVERB_MAX_MESSAGES_PER_MINUTE_PER_CHANNEL=120

# Vertical Scaling - Channel sharding and optimization
BROADCAST_CHANNEL_SHARDING_ENABLED=true

# Load Balancer - Sticky sessions for horizontal scaling
BROADCAST_STICKY_SESSIONS_ENABLED=true
BROADCAST_STICKY_SESSIONS_METHOD=cookie
BROADCAST_STICKY_COOKIE_NAME=reverb_server

# Monitoring - Prometheus/Grafana metrics
BROADCAST_MONITORING_ENABLED=true

# Fallback - Polling when WebSocket fails
BROADCAST_FALLBACK_ENABLED=true
BROADCAST_FALLBACK_POLLING_INTERVAL=10000
BROADCAST_FALLBACK_MAX_RETRIES=3

# === REDIS CLUSTER CONFIGURATION (Production 2026) ===
# Enable Redis Cluster for horizontal scaling across 28 verticals
# Set to true when using docker-compose.redis-cluster.yml
REDIS_CLUSTER_ENABLED=false

# Redis Cluster URL - comma-separated list of cluster nodes
# Format: redis://:password@host1:port1,host2:port2,...
REDIS_CLUSTER_URL=redis://:SuperSecretPass123!@redis-node-1:7001,redis-node-2:7002,redis-node-3:7003,redis-node-4:7004,redis-node-5:7005,redis-node-6:7006

# Redis Client: phpredis (recommended for cluster) or predis
REDIS_CLIENT=phpredis

# === HONEST SIGN (Честный ЗНАК) INTEGRATION ===
# Russian product labeling and certification system

# Honest Sign API Configuration
HONESTYSIGN_API_URL=https://api.crpt.ru
HONESTYSIGN_TOKEN=your_honest_sign_token

# Enable/Disable Honest Sign integration
HONESTYSIGN_ENABLED=true

# API timeout in seconds
HONESTYSIGN_TIMEOUT=30

# Cache TTL for mark validation (seconds)
HONESTYSIGN_CACHE_TTL=3600

# Retry configuration
HONESTYSIGN_MAX_RETRIES=3
HONESTYSIGN_RETRY_DELAY=1000

# Webhook configuration
HONESTYSIGN_WEBHOOK_SECRET=your_webhook_secret
HONESTYSIGN_WEBHOOK_ENABLED=false

# Redis Cluster Mode: redis (for cluster) or null (for standalone)
REDIS_CLUSTER_MODE=redis

# Redis Password - must match redis.conf requirepass
REDIS_PASSWORD=SuperSecretPass123!

# Redis Connection Settings (for standalone mode)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_REVERB_DB=2

# Redis Performance Tuning
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_READ_TIMEOUT=2.0
REDIS_WRITE_TIMEOUT=2.0
REDIS_PERSISTENT=false

# Payment Gateways
PAYMENT_DEFAULT_GATEWAY=tinkoff

# Tinkoff Bank
TINKOFF_API_URL=https://securepay.tinkoff.ru/v2
TINKOFF_TERMINAL_KEY=your_tinkoff_terminal_key
TINKOFF_SECRET_KEY=your_tinkoff_secret_key
TINKOFF_TIMEOUT=30

# Tochka Bank (B2B)
TOCHKA_API_URL=https://enter.tochka.com/api
TOCHKA_TOKEN=your_tochka_token
TOCHKA_TIMEOUT=30

# Sberbank (Сбер)
SBERBANK_API_URL=https://securepayments.sberbank.ru/payment/rest
SBERBANK_USERNAME=your_sberbank_username
SBERBANK_PASSWORD=your_sberbank_password
SBERBANK_TIMEOUT=30

# SBP (Система быстрых платежей)
SBP_API_URL=https://api.nspk.ru
SBP_API_KEY=your_sbp_api_key
SBP_TIMEOUT=30

# === AML/CTF Configuration (ФЗ-115 Compliance) ===
# Enable AML checks
AML_ENABLED=true

# Rosfinmonitoring Integration (ФЗ-115)
ROSFINMONITORING_ENABLED=false
ROSFINMONITORING_API_KEY=your_rosfinmonitoring_api_key
ROSFINMONITORING_API_URL=https://api.rosfinmonitoring.ru
ROSFINMONITORING_TIMEOUT=30
AML_AUTO_REPORT=false
ROSFINMONITORING_TEST_MODE=true

# Sanctions Screening
SANCTIONS_SCREENING_ENABLED=true
OFAC_ENABLED=false
OFAC_API_KEY=your_ofac_api_key
OFAC_API_URL=https://api.trade.gov.gov/v1/sanctions
EU_SANCTIONS_ENABLED=false
EU_SANCTIONS_API_KEY=your_eu_sanctions_api_key
EU_SANCTIONS_API_URL=

# AML Reporting
AML_SAR_AUTO_SUBMIT=false
AML_REPORTING_AUTHORITY=rosfinmonitoring
AML_TELEGRAM_ENABLED=false
AML_SLACK_ENABLED=false
AML_EMAIL_ENABLED=true

# Four-Eyes Approval
AML_FOUR_EYES_ENABLED=true

# BigData Integration
AML_BIGDATA_ENABLED=true

# Fraud Control Integration
AML_FRAUD_CONTROL_ENABLED=true

# === MARKETPLACE CONFIGURATION ===
# Ranking Weights (must sum to 1.0)
MARKETPLACE_POPULARITY_WEIGHT=0.25
MARKETPLACE_CONVERSION_WEIGHT=0.20
MARKETPLACE_RECENCY_WEIGHT=0.15
MARKETPLACE_RATING_WEIGHT=0.15
MARKETPLACE_PRICE_WEIGHT=0.10
MARKETPLACE_AVAILABILITY_WEIGHT=0.10
MARKETPLACE_PROMOTED_WEIGHT=0.03
MARKETPLACE_ML_WEIGHT=0.01
MARKETPLACE_PERSONALIZATION_WEIGHT=0.01

# Ranking Configuration
MARKETPLACE_ALGORITHM_VERSION=1.0.0
MARKETPLACE_RECALCULATION_INTERVAL=60
MARKETPLACE_ENABLE_ML=false
MARKETPLACE_ENABLE_PERSONALIZATION=false

# Aggregation Configuration
MARKETPLACE_BATCH_SIZE=100
MARKETPLACE_SYNC_INTERVAL=60
MARKETPLACE_SYNC_TIMEOUT=300

# Cache Configuration
MARKETPLACE_CACHE_ENABLED=true
MARKETPLACE_CACHE_TTL=300
MARKETPLACE_CACHE_PREFIX=marketplace:

# Verticals Configuration
MARKETPLACE_ACTIVE_VERTICALS=beauty,restaurant
MARKETPLACE_BEAUTY_ENABLED=true
MARKETPLACE_BEAUTY_AUTO_PUBLISH=false
MARKETPLACE_BEAUTY_SYNC_INTERVAL=60
MARKETPLACE_RESTAURANT_ENABLED=true
MARKETPLACE_RESTAURANT_AUTO_PUBLISH=true
MARKETPLACE_RESTAURANT_SYNC_INTERVAL=30

# Recommendations Configuration
MARKETPLACE_RECOMMENDATION_LIMIT=20
MARKETPLACE_SIMILARITY_THRESHOLD=0.3

