# IoT Configuration for CatVRF Restaurant Vertical
# Copy these variables to your .env file

# MQTT Broker Configuration
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=catvrf_iot_hub
MQTT_USE_TLS=false
MQTT_CONNECT_TIMEOUT=5
MQTT_SOCKET_TIMEOUT=5
MQTT_RESEND_TIMEOUT=10

# WebSocket Configuration
IOT_WEBSOCKET_ENABLED=true
IOT_WS_CHANNEL_PREFIX=iot.device

# Modbus Configuration
MODBUS_TIMEOUT=5.0
MODBUS_DEFAULT_PORT=502
MODBUS_RETRY_ATTEMPTS=3

# Telemetry Configuration
IOT_TELEMETRY_RETENTION_DAYS=90
IOT_TELEMETRY_BATCH_SIZE=100
IOT_CLICKHOUSE_ENABLED=false
IOT_CLICKHOUSE_DATABASE=catvrf_iot

# Alert Configuration
IOT_TEMP_WARNING=8.0
IOT_TEMP_CRITICAL=15.0
IOT_WEIGHT_MIN=0.01
IOT_OFFLINE_THRESHOLD=5

# Device Configuration
IOT_AUTO_REGISTER=false
IOT_REQUIRE_APPROVAL=true
IOT_HEARTBEAT_INTERVAL=60
