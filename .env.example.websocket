# ═══════════════════════════════════════════════════════════════
# WEBSOCKET SCALING CONFIGURATION - 28 VERTICALS
# ═══════════════════════════════════════════════════════════════
# Laravel Reverb Horizontal Scaling Configuration
# Add these to your .env file as needed
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# REVERB SCALING - Horizontal Scaling with Redis
# ═══════════════════════════════════════════════════════════════
# Enable Redis adapter for horizontal scaling across multiple Reverb servers
REVERB_SCALING_ENABLED=true

# Redis connection for Reverb scaling (must match config/database.php)
REVERB_REDIS_CONNECTION=default

# Redis key prefix for Reverb channels
REVERB_REDIS_PREFIX=reverb

# ═══════════════════════════════════════════════════════════════
# REVERB CONNECTION LIMITS
# ═══════════════════════════════════════════════════════════════
# Maximum concurrent connections per Reverb instance
# Adjust based on your infrastructure capacity
# Recommended: 10000-50000 depending on server specs
REVERB_MAX_CONNECTIONS=10000

# ═══════════════════════════════════════════════════════════════
# REVERB RATE LIMITING - Global abuse prevention
# ═══════════════════════════════════════════════════════════════
# Enable global rate limiting for broadcast events
REVERB_RATE_LIMITING_ENABLED=true

# Maximum messages per second across all channels
REVERB_MAX_MESSAGES_PER_SECOND=1000

# Maximum messages per minute per channel (prevents single order spam)
REVERB_MAX_MESSAGES_PER_MINUTE_PER_CHANNEL=120

# ═══════════════════════════════════════════════════════════════
# VERTICAL SCALING - Channel Sharding & Optimization
# ═══════════════════════════════════════════════════════════════
# Enable vertical-prefixed channel sharding (v_taxi:order.123.tracking)
BROADCAST_CHANNEL_SHARDING_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# LOAD BALANCER - Sticky Sessions for Horizontal Scaling
# ═══════════════════════════════════════════════════════════════
# Enable sticky sessions on load balancer (required for horizontal scaling)
BROADCAST_STICKY_SESSIONS_ENABLED=true

# Sticky session method: 'cookie' or 'ip'
BROADCAST_STICKY_SESSIONS_METHOD=cookie

# Cookie name for sticky sessions
BROADCAST_STICKY_COOKIE_NAME=reverb_server

# ═══════════════════════════════════════════════════════════════
# MONITORING - Prometheus/Grafana Metrics
# ═══════════════════════════════════════════════════════════════
# Enable metrics collection for monitoring
BROADCAST_MONITORING_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# FALLBACK - Polling when WebSocket fails
# ═══════════════════════════════════════════════════════════════
# Enable fallback to polling if WebSocket connection fails
BROADCAST_FALLBACK_ENABLED=true

# Polling interval in milliseconds (for low-priority verticals)
BROADCAST_FALLBACK_POLLING_INTERVAL=10000

# Maximum retry attempts before giving up
BROADCAST_FALLBACK_MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════
# DOCKER COMPOSE / KUBERNETES DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════
#
# For horizontal scaling, deploy multiple Reverb instances behind a load balancer:
#
# docker-compose.yml example:
#   reverb-1:
#     image: laravel/reverb:latest
#     env_file: .env
#   reverb-2:
#     image: laravel/reverb:latest
#     env_file: .env
#   reverb-3:
#     image: laravel/reverb:latest
#     env_file: .env
#   reverb-4:
#     image: laravel/reverb:latest
#     env_file: .env
#
# Load balancer configuration (nginx example):
#   - Enable sticky sessions by IP or cookie
#   - Use round-robin with session affinity
#   - Health check on /health endpoint
#
# Redis configuration:
#   - Use Redis Cluster or Sentinel for production
#   - Ensure low latency (< 8ms) between Reverb instances and Redis
#   - Monitor Redis memory usage for channel subscriptions
#
# ═══════════════════════════════════════════════════════════════
# PRODUCTION MONITORING METRICS (Prometheus/Grafana)
# ═══════════════════════════════════════════════════════════════
#
# Key metrics to monitor:
#   - broadcast_concurrent_connections_total
#   - broadcast_messages_per_second
#   - broadcast_vertical_{vertical}_messages_total
#   - broadcast_vertical_{vertical}_connections_total
#   - redis_latency_ms (should be < 8ms)
#   - reverb_memory_usage_bytes
#
# Alerts:
#   - Concurrent connections > 80% of REVERB_MAX_CONNECTIONS
#   - Redis latency > 20ms
#   - Messages per second > REVERB_MAX_MESSAGES_PER_SECOND
#   - Vertical-specific rate limit breaches
#
# ═══════════════════════════════════════════════════════════════
