# CDN Configuration
CDN_PROVIDER=cloudflare
CDN_ENABLED=false

# Cloudflare Images
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_ACCOUNT_KEY=your_account_key
CLOUDFLARE_IMAGES_ENABLED=false
CLOUDFLARE_POLISH_ENABLED=false

# Bunny CDN
BUNNY_API_KEY=your_bunny_api_key
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_PULL_ZONE=your_pull_zone
BUNNY_OPTIMIZER_ENABLED=false

# Video CDN
CDN_VIDEO_PROVIDER=bunny_stream
CDN_VIDEO_ENABLED=false

# Bunny Stream
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key
BUNNY_STREAM_LIBRARY_ID=your_library_id

# Cloudflare Stream
CLOUDFLARE_STREAM_API_TOKEN=your_stream_api_token

# CDN Cache
CDN_CACHE_TTL=31536000
CDN_BYPASS_CACHE=false
