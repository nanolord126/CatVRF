APP_NAME="CatVRF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=/workspace/database/database.sqlite
# DB_USERNAME=catvrf
# DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Multi-tenancy
TENANCY_DATABASE_PREFIX=tenant_
TENANCY_DATABASE_SEPARATOR=_

# AI Services
OPENAI_API_KEY=
GIGACHAT_API_KEY=

# Fraud Detection
FRAUD_CHECK_ENABLED=true
FRAUD_ML_ENABLED=true

# Analytics
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=catvrf_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# BigData
BIGDATA_ENABLED=true
BIGDATA_CLICKHOUSE_HOST=127.0.0.1
BIGDATA_CLICKHOUSE_PORT=8123

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
