# LiveKit WebRTC Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Video Recording Configuration
VIDEO_RECORDING_DISK=s3
VIDEO_RECORDING_RETENTION_DAYS=30
VIDEO_RECORDING_AUTO_PROCESS=true

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Video Optimization
VIDEO_ENABLE_HLS=true
VIDEO_ENABLE_AVIF=false
VIDEO_WATERMARK_ENABLED=false
VIDEO_WATERMARK_TEXT=

# Video Processing Queue
VIDEO_PROCESSING_QUEUE=video-processing
VIDEO_PROCESSING_TIMEOUT=1800
VIDEO_PROCESSING_TRIES=3
