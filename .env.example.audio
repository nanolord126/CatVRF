# Audio CDN Configuration
AUDIO_CDN_PROVIDER=bunny

# Bunny CDN
BUNNY_API_KEY=your_bunny_api_key
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_AUDIO_HOSTNAME=your-audio.b-cdn.net
BUNNY_PULL_ZONE=your_pull_zone

# Cloudflare Stream (alternative)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_EMAIL=your_email@example.com

# AWS CloudFront + S3 (alternative)
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
AWS_CLOUDFRONT_KEY_ID=your_key_id
AWS_CLOUDFRONT_PRIVATE_KEY=path/to/private_key.pem
AWS_S3_AUDIO_BUCKET=catvrf-audio

# Audio Processing Settings
AUDIO_DEFAULT_FORMAT=opus
AUDIO_OPUS_BITRATE=64k
AUDIO_AAC_BITRATE=128k
AUDIO_SAMPLE_RATE=48000
AUDIO_LOUDNORM_TARGET=I=-16:TP=-1.5:LRA=11

# Signed URL Settings
AUDIO_SIGNED_URL_TTL=1440
AUDIO_SIGNED_URL_MAX_TTL=10080

# Queue Settings
AUDIO_QUEUE_NAME=audio-processing
AUDIO_QUEUE_CONNECTION=redis
AUDIO_QUEUE_MEMORY_LIMIT=512

# FFmpeg Path (if not in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
