{
  "family": "catvrf-redis-cluster",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "containerDefinitions": [
    {
      "name": "redis-node-1",
      "image": "redis:7.2-alpine",
      "essential": true,
      "command": [
        "redis-server",
        "/usr/local/etc/redis/redis.conf"
      ],
      "portMappings": [
        {
          "containerPort": 7001,
          "protocol": "tcp"
        },
        {
          "containerPort": 17001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "REDIS_PASSWORD",
          "value": "${REDIS_PASSWORD}"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "redis-data-1",
          "containerPath": "/data"
        },
        {
          "sourceVolume": "redis-config",
          "containerPath": "/usr/local/etc/redis"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/catvrf-redis-cluster",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "redis"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "redis-cli -p 7001 -a ${REDIS_PASSWORD} ping"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 3
      }
    },
