# BigData Monitoring & Observability Environment Variables
# Copy to .env and fill in real values

# ==================== BigData Monitoring ====================
BIGDATA_MONITORING_ENABLED=true
BIGDATA_ALERT_LAG_THRESHOLD=10000
BIGDATA_ALERT_ERROR_RATE=0.05
BIGDATA_DISK_MAX_BYTES=500000000000
BIGDATA_CONSUMER_COUNT=1

# ==================== OpenTelemetry ====================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=catvrf-bigdata
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACES_ENABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLE_RATE=0.1
OTEL_METRICS_ENABLED=false
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://tempo:4317
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_LOGS_ENABLED=false
LOKI_ENDPOINT=http://loki:3100
LOKI_TENANT_ID=
OTEL_PROPAGATORS=tracecontext,baggage

# BigData-specific OTel tracing
OTEL_BIGDATA_TRACE_EVENTS=true
OTEL_BIGDATA_TRACE_KAFKA_PRODUCE=true
OTEL_BIGDATA_TRACE_KAFKA_CONSUME=true
OTEL_BIGDATA_TRACE_CH_QUERIES=true
OTEL_BIGDATA_TRACE_SPARK=true
OTEL_BIGDATA_CORRELATION_HEADER=X-Correlation-ID

# ==================== Grafana ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=catvrf2026

# ==================== ClickHouse Exporter ====================
CLICKHOUSE_EXPORTER_HOST=clickhouse
CLICKHOUSE_EXPORTER_PORT=9116

# ==================== Kafka Exporter ====================
KAFKA_EXPORTER_BROKERS=kafka:9092

# ==================== Pushgateway (Spark metrics) ====================
PUSHGATEWAY_URL=http://pushgateway:9091

# ==================== Alertmanager Channels ====================
# PagerDuty
PAGERDUTY_SERVICE_KEY=your_pagerduty_service_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BIGDATA_CHAT_ID=your_bigdata_chat_id
TELEGRAM_BIGDATA_ONCALL_CHAT_ID=your_oncall_chat_id

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
