# ═══════════════════════════════════════════════════════════════
# LARAVEL REVERB WEBSOCKET SCALING CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Environment variables for horizontal scaling across 28 verticals
# Copy this file to .env and adjust values for your environment
# ═══════════════════════════════════════════════════════════════

BROADCAST_DRIVER=reverb

# ═══════════════════════════════════════════════════════════════
# REVERB SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════

REVERB_APP_ID=laravel
REVERB_APP_KEY=your-app-key-here
REVERB_APP_SECRET=your-app-secret-here
REVERB_HOST=0.0.0.0
REVERB_PORT=6001
REVERB_SCHEME=http

# ═══════════════════════════════════════════════════════════════
# REVERB SCALING (Horizontal Scaling via Redis)
# ═══════════════════════════════════════════════════════════════
# Enable Redis adapter for multi-instance deployment
# All Reverb instances will share channel state via Redis pub/sub

REVERB_SCALING_ENABLED=true
REVERB_REDIS_CONNECTION=default
REVERB_REDIS_PREFIX=reverb

# ═══════════════════════════════════════════════════════════════
# REVERB CONNECTION LIMITS
# ═══════════════════════════════════════════════════════════════
# Maximum concurrent connections per Reverb instance
# With 4 instances: 4 * 10000 = 40000 total concurrent connections

REVERB_MAX_CONNECTIONS=10000

# ═══════════════════════════════════════════════════════════════
# REVERB RATE LIMITING
# ═══════════════════════════════════════════════════════════════
# Global rate limiting to prevent abuse across all verticals

REVERB_RATE_LIMITING_ENABLED=true
REVERB_MAX_MESSAGES_PER_SECOND=1000
REVERB_MAX_MESSAGES_PER_MINUTE_PER_CHANNEL=120

# ═══════════════════════════════════════════════════════════════
# VERTICAL SCALING CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Channel sharding and optimization for 28 verticals

BROADCAST_CHANNEL_SHARDING_ENABLED=true
BROADCAST_STICKY_SESSIONS_ENABLED=true
BROADCAST_STICKY_SESSIONS_METHOD=cookie
BROADCAST_STICKY_COOKIE_NAME=reverb_server

# ═══════════════════════════════════════════════════════════════
# MONITORING & METRICS
# ═══════════════════════════════════════════════════════════════
# Enable Prometheus/Grafana metrics collection

BROADCAST_MONITORING_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# FALLBACK CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Fallback to polling if WebSocket connection fails

BROADCAST_FALLBACK_ENABLED=true
BROADCAST_FALLBACK_POLLING_INTERVAL=10000
BROADCAST_FALLBACK_MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════
# REDIS CONFIGURATION (for Reverb scaling)
# ═══════════════════════════════════════════════════════════════

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_CACHE_DB=1

# ═══════════════════════════════════════════════════════════════
# QUEUE CONFIGURATION (for broadcast jobs)
# ═══════════════════════════════════════════════════════════════

QUEUE_CONNECTION=redis
QUEUE_NAME=default

# ═══════════════════════════════════════════════════════════════
# PRODUCTION NOTES
# ═══════════════════════════════════════════════════════════════
# 
# 1. For production:
#    - Change REVERB_SCHEME to https
#    - Use strong REVERB_APP_KEY and REVERB_APP_SECRET
#    - Increase REVERB_MAX_CONNECTIONS based on server capacity
#    - Use Redis Cluster for high availability
#    - Enable SSL/TLS for WebSocket connections
#
# 2. Load Balancer:
#    - Configure sticky sessions (session affinity)
#    - Use NGINX/Traefik with WebSocket support
#    - Enable health checks for Reverb instances
#
# 3. Monitoring:
#    - Track concurrent connections per instance
#    - Monitor Redis pub/sub latency (< 8ms)
#    - Set up alerts for connection limits
#    - Use Prometheus + Grafana for metrics
#
# 4. Vertical priorities:
#    - critical: taxi, pharmacy, delivery, fraud_ml, security, geo_logistics, payment, realtime
#    - high: confectionery, flowers, food, grocery_and_delivery, meat_shops, communication, geo, marketplace, notifications, cart, search, wallet
#    - medium: auto, car_rental, hotels, furniture, a_i, analytics, finances, geo, inventory, c_r_m, bonuses, commissions, payout, audit, user_profile, compliance, staff
#    - low: beauty, cleaning_services, fitness, home_services, medical, real_estate, short_term_rentals, advertising, referral, h_r
# ═══════════════════════════════════════════════════════════════
