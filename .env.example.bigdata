# ============================================================
# Big Data Cloud Services Configuration
# ============================================================
# This file contains configuration for cloud-managed services
# that replace Docker-based infrastructure.
#
# Services:
# - ClickHouse: Local (WSL) or ClickHouse Cloud
# - Kafka: Confluent Cloud REST Proxy or Redis Streams fallback
# - Redis: Local or Redis Cloud
# - Storage: AWS S3 or MinIO Cloud
# - Monitoring: Grafana Cloud
# ============================================================

# === ClickHouse ===
# Local (WSL): localhost:8123
# Cloud: your-cluster.clickhouse.cloud:8443
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=catvrf_bigdata
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CONNECT_TIMEOUT=5
CLICKHOUSE_QUERY_TIMEOUT=30

# === Kafka / Confluent Cloud ===
# Sign up: https://confluent.cloud/ (free tier: 1 cluster, 100K messages/month)
# After signup, get:
#   - Bootstrap servers (e.g., pkc-xxxxx.us-east-1.aws.confluent.cloud:9092)
#   - API Key + Secret (from Settings > API keys)
#   - REST Proxy URL (from Cluster settings)
KAFKA_ENABLED=true
KAFKA_MODE=redis_streams
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=bigdata_events
KAFKA_CONSUMER_GROUP_ID=bigdata_consumer
KAFKA_REST_PROXY_URL=
KAFKA_CLUSTER_ID=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TIMEOUT_MS=10000
KAFKA_MAX_MESSAGES=1000

# === Redis ===
# Local: 127.0.0.1:6379
# Redis Cloud: https://redis.com/try-free/ (30MB free)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# === Storage (S3 / MinIO) ===
# AWS S3: https://aws.amazon.com/s3/ (5GB free tier)
# MinIO Cloud: https://min.io/
BIGDATA_STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BIGDATA_S3_BUCKET=catvrf-bigdata
AWS_ENDPOINT_URL=

# MinIO (if using MinIO Cloud)
MINIO_ENDPOINT=http://localhost:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=catvrf-bigdata

# === Grafana Cloud ===
# Sign up: https://grafana.com/auth/sign-up/cloud/ (free: 3 dashboards, 10K series)
# After signup, get:
#   - Grafana URL (e.g., your-org.grafana.net)
#   - API Key (from Configuration > API Keys)
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_DATASOURCE_ID=
PROMETHEUS_URL=http://localhost:9090

# === Spark ===
SPARK_ENABLED=false
SPARK_MASTER=local[*]
SPARK_APP_NAME=CatVRF-BigData
SPARK_MEMORY=4g
SPARK_CORES=4

# === Retention ===
BIGDATA_RETENTION_RAW_DAYS=90
BIGDATA_RETENTION_DAILY_DAYS=730
BIGDATA_RETENTION_CLV_DAYS=365
BIGDATA_RETENTION_ABTEST_DAYS=365

# === Cache & Queues ===
BIGDATA_CACHE_TTL=3600
BIGDATA_QUEUE_KAFKA=bigdata-kafka
BIGDATA_QUEUE_SPARK=bigdata-spark
BIGDATA_MONITORING_ENABLED=true
BIGDATA_ALERT_LAG_THRESHOLD=10000
BIGDATA_ALERT_ERROR_RATE=0.05
