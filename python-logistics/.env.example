# Application
APP_NAME=CatVRF Logistics Inference API
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ClickHouse Feature Store
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis (for Laravel integration)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_KEY=logistics:inference:queue
REDIS_RESULT_KEY_PREFIX=logistics:inference:result:

# ML Models
MODELS_DIR=/app/models
COURIER_ASSIGNMENT_MODEL=courier_assignment_v1.onnx
PVZ_SCORING_MODEL=pvz_scoring_v1.onnx
ETA_PREDICTION_MODEL=eta_prediction_v1.onnx
DEMAND_FORECAST_MODEL=demand_forecast_v1.onnx
ONNX_INFERENCE_THREADS=4
ENABLE_MODEL_CACHE=true

# External APIs
YANDEX_API_KEY=
TWO_GIS_API_KEY=
WEATHER_API_KEY=

# Agentic AI
ENABLE_AGENT=true
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4-turbo
AGENT_LLM_API_KEY=sk-...
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300

# WebSocket
WEBSOCKET_ENABLED=true
WEBSOCKET_URL=ws://localhost:6001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/inference.log

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_TRACING=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
