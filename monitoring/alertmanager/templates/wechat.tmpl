{{ define "wechat.default.json" }}
{
  "msgtype": "text",
  "text": {
    "content": "{{ range $alert := .Alerts }}【{{ $alert.Status | toUpper }}】{{ $alert.Labels.alertname }}\n\nSeverity: {{ $alert.Labels.severity | toUpper }}\nSummary: {{ $alert.Annotations.summary }}\nDescription: {{ $alert.Annotations.description }}\n\nCluster: {{ $alert.Labels.cluster }}\nService: {{ $alert.Labels.service }}\n{{ if $alert.Labels.vertical }}Vertical: {{ $alert.Labels.vertical }}\n{{ end }}{{ if $alert.Labels.queue }}Queue: {{ $alert.Labels.queue }}\n{{ end }}Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}Runbook: {{ $alert.Annotations.runbook }}\n{{ end }}---\n{{ end }}"
  }
}
{{ end }}

{{ define "wechat.critical.json" }}
{
  "msgtype": "markdown",
  "markdown": {
    "content": "🚨 <font color=\"warning\">CRITICAL ALERT</font> 🚨\n\n{{ range $alert := .Alerts }}### {{ $alert.Labels.alertname }}\n>Severity: **CRITICAL**\n>Summary: {{ $alert.Annotations.summary }}\n>Description: {{ $alert.Annotations.description }}\n\n**Details:**\n- Cluster: {{ $alert.Labels.cluster }}\n- Service: {{ $alert.Labels.service }}\n{{ if $alert.Labels.vertical }}- Vertical: {{ $alert.Labels.vertical }}\n{{ end }}{{ if $alert.Labels.queue }}- Queue: {{ $alert.Labels.queue }}\n{{ end }}- Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}[View Runbook]({{ $alert.Annotations.runbook }})\n{{ end }}---\n{{ end }}"
  }
}
{{ end }}

{{ define "wechat.supermarket.json" }}
{
  "msgtype": "markdown",
  "markdown": {
    "content": "🛒 <font color=\"info\">Supermarket Alert</font>\n\n{{ range $alert := .Alerts }}### {{ $alert.Labels.alertname }}\n>Severity: **{{ $alert.Labels.severity | toUpper }}**\n>Summary: {{ $alert.Annotations.summary }}\n>Description: {{ $alert.Annotations.description }}\n\n**Context:**\n- Queue: {{ $alert.Labels.queue }}\n- Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}[View Runbook]({{ $alert.Annotations.runbook }})\n{{ end }}---\n{{ end }}"
  }
}
{{ end }}

