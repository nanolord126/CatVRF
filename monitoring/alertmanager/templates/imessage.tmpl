{{ define "imessage.default.json" }}
{
  "aps": {
    "alert": {
      "title": "{{ .CommonLabels.alertname }}",
      "body": "{{ range $alert := .Alerts }}{{ $alert.Annotations.summary }}\n\nSeverity: {{ $alert.Labels.severity | toUpper }}\nDescription: {{ $alert.Annotations.description }}\nCluster: {{ $alert.Labels.cluster }}\nService: {{ $alert.Labels.service }}\nStarted: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n{{ end }}"
    }
  }
}
{{ end }}

{{ define "imessage.critical.json" }}
{
  "aps": {
    "alert": {
      "title": "🚨 CRITICAL: {{ .CommonLabels.alertname }}",
      "body": "{{ range $alert := .Alerts }}Severity: CRITICAL\nSummary: {{ $alert.Annotations.summary }}\nDescription: {{ $alert.Annotations.description }}\n\nCluster: {{ $alert.Labels.cluster }}\nService: {{ $alert.Labels.service }}\n{{ if $alert.Labels.vertical }}Vertical: {{ $alert.Labels.vertical }}\n{{ end }}{{ if $alert.Labels.queue }}Queue: {{ $alert.Labels.queue }}\n{{ end }}Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}Runbook: {{ $alert.Annotations.runbook }}\n{{ end }}{{ end }}",
      "sound": "default"
    }
  }
}
{{ end }}

