{{ define "kakao.default.json" }}
{
  "object_type": "text",
  "text": "{{ range $alert := .Alerts }}[{{ $alert.Status | toUpper }}] {{ $alert.Labels.alertname }}\nSeverity: {{ $alert.Labels.severity | toUpper }}\nSummary: {{ $alert.Annotations.summary }}\nDescription: {{ $alert.Annotations.description }}\n\nCluster: {{ $alert.Labels.cluster }}\nService: {{ $alert.Labels.service }}\n{{ if $alert.Labels.vertical }}Vertical: {{ $alert.Labels.vertical }}\n{{ end }}{{ if $alert.Labels.queue }}Queue: {{ $alert.Labels.queue }}\n{{ end }}Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}Runbook: {{ $alert.Annotations.runbook }}\n{{ end }}---\n{{ end }}"
}
{{ end }}

{{ define "kakao.critical.json" }}
{
  "object_type": "list",
  "header_text": "🚨 CRITICAL ALERT 🚨",
  "link": {
    "web_url": "{{ (index .Alerts 0).Annotations.grafana }}",
    "mobile_web_url": "{{ (index .Alerts 0).Annotations.grafana }}"
  },
  "buttons": [
    {
      "title": "View in Grafana",
      "type": "web_link",
      "web_url": "{{ (index .Alerts 0).Annotations.grafana }}"
    }
  ],
  "items": [
    {{ range $i, $alert := .Alerts }}{{ if $i }},{{ end }}
    {
      "header": "{{ $alert.Labels.alertname }}",
      "description": "Severity: CRITICAL\nSummary: {{ $alert.Annotations.summary }}\nDescription: {{ $alert.Annotations.description }}\n\nCluster: {{ $alert.Labels.cluster }}\nService: {{ $alert.Labels.service }}\n{{ if $alert.Labels.vertical }}Vertical: {{ $alert.Labels.vertical }}\n{{ end }}{{ if $alert.Labels.queue }}Queue: {{ $alert.Labels.queue }}\n{{ end }}Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}"
    }
    {{ end }}
  ]
}
{{ end }}

{{ define "kakao.supermarket.json" }}
{
  "object_type": "text",
  "text": "🛒 Supermarket Alert\n\n{{ range $alert := .Alerts }}Alert: {{ $alert.Labels.alertname }}\nSeverity: {{ $alert.Labels.severity | toUpper }}\nSummary: {{ $alert.Annotations.summary }}\nDescription: {{ $alert.Annotations.description }}\n\nContext:\n- Queue: {{ $alert.Labels.queue }}\n- Started: {{ $alert.StartsAt.Format \"2006-01-02 15:04:05\" }}\n\n{{ if $alert.Annotations.runbook }}Runbook: {{ $alert.Annotations.runbook }}\n{{ end }}---\n{{ end }}"
}
{{ end }}

