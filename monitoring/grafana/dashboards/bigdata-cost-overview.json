{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Total Big Data Cost (Daily)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "catvrf_bigdata_cost_daily_total_usd",
          "legendFormat": "Total Cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Cost by Category",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "catvrf_bigdata_cost_daily_by_category_usd",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Budget Utilization",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "catvrf_bigdata_cost_budget_utilization_percent",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          },
          "max": 120
        }
      }
    },
    {
      "title": "Monthly Forecast vs Budget",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "catvrf_bigdata_cost_budget_current_spend_usd", "legendFormat": "Current Spend", "refId": "A" },
        { "expr": "catvrf_bigdata_cost_budget_predicted_total_usd", "legendFormat": "Predicted Total", "refId": "B" },
        { "expr": "catvrf_bigdata_cost_budget_monthly_usd", "legendFormat": "Budget", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Optimizable Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "expr": "catvrf_bigdata_cost_daily_optimizable_usd", "legendFormat": "Optimizable", "refId": "A" },
        { "expr": "catvrf_bigdata_cost_daily_optimization_potential_usd", "legendFormat": "Potential Savings", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Storage Growth Rate (%/week)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "catvrf_bigdata_cost_storage_growth_rate_percent", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          },
          "max": 30
        }
      }
    },
    {
      "title": "Open Anomalies",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "expr": "catvrf_bigdata_cost_anomaly_open_count", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Cost Trend (30d)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "catvrf_bigdata_cost_daily_by_category_usd",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "stacking": { "mode": "normal" } }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["bigdata", "finops", "cost"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "title": "Big Data Cost Overview",
  "uid": "bigdata-cost-overview",
  "version": 1
}
